<resources>
    <!-- The app and test host share this platform theme. Android 15 compares the
         resolved navigation color with its default COLOR VALUE (not hasValue).
         Therefore explicitly writing transparent is still treated as unspecified
         on a transparent-default device. Keep the original app's opaque launch
         color here; SeasonSystemBars makes it transparent after creation and owns
         the seasonal backing and icon contrast. No hidden flags or API opt-outs. -->
    <style name="Theme.Luke.Native" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F1F9F5</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#F1F9F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
