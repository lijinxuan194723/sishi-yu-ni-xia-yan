<resources>
    <!-- Shared by the real application and the instrumentation host. Specifying
         navigationBarColor BEFORE DecorView is created prevents Android 15 from
         inferring a sticky force-light appearance from the initial window color.
         Runtime icon contrast remains owned by SeasonSystemBars; no hidden flags
         or edge-to-edge opt-outs are used. -->
    <style name="Theme.Luke.Native" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F1F9F5</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
